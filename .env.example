# URL del Web App de Google Apps Script (termina en /exec)
GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/REEMPLAZAR/exec

# Secreto compartido entre Vercel y Apps Script
GNV_SHARED_SECRET=REEMPLAZAR_POR_UN_VALOR_LARGO_Y_ALEATORIO

# Secreto exclusivo para firmar sesiones. Si se omite, se usa GNV_SHARED_SECRET.
GNV_SESSION_SECRET=REEMPLAZAR_POR_OTRO_VALOR_LARGO_Y_ALEATORIO

# Clave temporal para usuarios cuyo ClaveHash está vacío.
# Al ingresar con esta clave, el sistema obliga a cambiarla.
GNV_INITIAL_PASSWORD=REEMPLAZAR_POR_CLAVE_TEMPORAL_SEGURA
